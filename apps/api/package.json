{
  "name": "@palwarden/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint src/**/*.ts test/**/*.ts",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "cross-env DOTENV_CONFIG_PATH=../../.env node -r dotenv/config node_modules/prisma/build/index.js migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "cross-env RUST_LOG=info DOTENV_CONFIG_PATH=../../.env node -r dotenv/config node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.2.3",
    "@palwarden/shared": "workspace:*",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "nanoid": "^5.1.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.12",
    "@nestjs/testing": "^11.1.28",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "vitest": "^4.0.14"
  }
}
