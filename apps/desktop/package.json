{
  "name": "@palwarden/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Palwarden desktop shell",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src/**/*.ts",
    "test": "node -e \"console.log('No desktop tests yet')\"",
    "dist:win": "electron-builder --win portable --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.10.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.palwarden.desktop",
    "productName": "Palwarden",
    "directories": {
      "output": "../../dist/electron"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../dist/windows/Palwarden",
        "to": "palwarden-runtime"
      }
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
