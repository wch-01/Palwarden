{
  "name": "@palwarden/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Palwarden desktop shell",
  "author": "Palwarden",
  "homepage": "https://github.com/wch-01/Palwarden",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src/**/*.ts",
    "test": "node -e \"console.log('No desktop tests yet')\"",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.10.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.palwarden.desktop",
    "productName": "Palwarden",
    "copyright": "Copyright © 2026 Palwarden",
    "directories": {
      "output": "../../dist/electron"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../dist/windows/Palwarden",
        "to": "palwarden-runtime"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "publisherName": "Palwarden",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}-windows-x64-installer.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": true,
      "shortcutName": "Palwarden",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    }
  }
}
